<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ETS2DayNightModern.MainWindow"
        Title="ETS2昼夜切换"
        Width="680" Height="600" MinWidth="620" MinHeight="580"
        SystemDecorations="Full" ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="58"
        WindowStartupLocation="CenterScreen">
  <Border x:Name="WindowFrame" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          CornerRadius="8" ClipToBounds="True"
          Margin="{ReflectionBinding OffScreenMargin, RelativeSource={RelativeSource AncestorType=Window}}">
  <Grid RowDefinitions="58,*">
    <Border x:Name="WindowTitleBar" Background="#101012" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
    <Grid ColumnDefinitions="*,Auto">
      <Grid x:Name="TitleDragRegion" ColumnDefinitions="Auto,*" Background="Transparent"
            Margin="18,0,0,0" PointerPressed="TitleBar_PointerPressed">
      <Border Width="30" Height="30" CornerRadius="8" ClipToBounds="True"
              VerticalAlignment="Center">
        <Image Source="avares://ETS2昼夜切换/Assets/ets2_logo.png" Stretch="UniformToFill" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="3" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="ETS2 昼夜切换" FontSize="13" FontWeight="SemiBold" />
        <TextBlock Text="DRIVING TOOLS" FontSize="9" LetterSpacing="1.7"
                   Foreground="{DynamicResource SubtleBrush}" />
      </StackPanel>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,7,0" VerticalAlignment="Center">
        <Button x:Name="UpdateButton" Classes="windowControl" Width="100" Margin="0,0,6,0"
                Click="Update_Click" ToolTip.Tip="软件更新" AutomationProperties.Name="软件更新">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Path Data="M2 6A5 5 0 0 1 11 3 M11 0V3H8 M12 8A5 5 0 0 1 3 11 M3 14V11H6"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2" Width="14" Height="14" />
            <TextBlock x:Name="UpdateButtonText" Text="软件更新" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="MinimizeButton" Classes="windowControl" Click="Minimize_Click"
                Focusable="False" IsTabStop="False" ToolTip.Tip="最小化" AutomationProperties.Name="最小化">
          <Path Data="M2 6H12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2" Width="14" Height="14" />
        </Button>
        <Button x:Name="MaximizeButton" Classes="windowControl" Click="Maximize_Click"
                Focusable="False" IsTabStop="False" ToolTip.Tip="最大化" AutomationProperties.Name="最大化">
          <Path x:Name="MaximizeIcon" Data="M2 2H12V12H2Z"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2" Width="14" Height="14" />
        </Button>
        <Button x:Name="CloseButton" Classes="windowControl close" Click="Close_Click"
                Focusable="False" IsTabStop="False" ToolTip.Tip="关闭" AutomationProperties.Name="关闭">
          <Path Data="M3 3L11 11 M11 3L3 11"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2" Width="14" Height="14" />
        </Button>
      </StackPanel>
    </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" Margin="25,20,25,18">
      <StackPanel Spacing="18">
        <Grid ColumnDefinitions="*,*">
          <Border Classes="card" Padding="17,14" Margin="0,0,6,0">
            <Grid ColumnDefinitions="Auto,*">
              <Viewbox Width="19" Height="19" VerticalAlignment="Top" Margin="0,2,12,0">
                <Canvas Width="24" Height="24">
                  <Ellipse Width="18" Height="18" Canvas.Left="3" Canvas.Top="3"
                           Stroke="#A09DA7" StrokeThickness="1.6" />
                  <Path Data="M12 7V12L15 14" Stroke="#A09DA7" StrokeThickness="1.6" />
                </Canvas>
              </Viewbox>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="游戏时间" Classes="caption" />
                <TextBlock x:Name="GameTimeText" Text="--:--" FontSize="25" FontWeight="Medium" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="card" Padding="17,14" Margin="6,0,0,0">
            <Grid ColumnDefinitions="Auto,*">
              <Viewbox Width="19" Height="19" VerticalAlignment="Top" Margin="0,2,12,0">
                <Canvas Width="24" Height="24">
                  <Path Data="M12 3L21 7V12C21 17 17 20 12 22 7 20 3 17 3 12V7Z M8 12L11 15 16 9"
                        Stroke="#BDA2ED" StrokeThickness="1.5" />
                </Canvas>
              </Viewbox>
              <StackPanel Grid.Column="1" Spacing="9">
                <TextBlock Text="当前环境" Classes="caption" />
                <TextBlock x:Name="EnvironmentText" Text="环境：—" FontSize="15"
                           FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <Border Classes="card" Padding="22,18,22,17">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="7" VerticalAlignment="Center">
                <TextBlock Text="自定义时间" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="拖动滑块，松开即应用" Classes="caption" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="0" HorizontalAlignment="Right">
                <TextBlock x:Name="SelectedTimeText" Text="12:00" FontSize="42"
                           FontWeight="Medium" LetterSpacing="-1.3" LineHeight="48"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="SelectionPeriodText" Text="白天 · DAYTIME" FontSize="9"
                           LetterSpacing="1.2" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Grid>
            <Slider x:Name="TimeSlider" Classes="time" Minimum="0" Maximum="1439" Value="720"
                    TickFrequency="60" IsSnapToTickEnabled="False" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="*,*,*,*" Margin="0,-3,0,0">
              <TextBlock Text="00:00" Classes="caption" FontSize="10" />
              <TextBlock Grid.Column="1" Text="06:00" Classes="caption" FontSize="10" HorizontalAlignment="Left" Margin="-12,0,0,0" />
              <TextBlock Grid.Column="2" Text="12:00" Classes="caption" FontSize="10" HorizontalAlignment="Left" Margin="-12,0,0,0" />
              <TextBlock Grid.Column="3" Text="18:00" Classes="caption" FontSize="10" HorizontalAlignment="Left" Margin="-12,0,0,0" />
              <TextBlock Grid.Column="3" Text="23:59" Classes="caption" FontSize="10" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Spacing="11">
          <TextBlock Text="快捷时刻" Classes="section" />
          <Grid ColumnDefinitions="*,*,*,*">
            <Button x:Name="PresetMorning" Classes="preset" Margin="0,0,5,0" Tag="360"
                    Click="Preset_Click" Focusable="False" IsTabStop="False" AutomationProperties.Name="清晨 06:00">
              <StackPanel Spacing="9">
                <Viewbox Width="22" Height="22" HorizontalAlignment="Left">
                  <Canvas Width="24" Height="24">
                    <Path Data="M3 18H21 M5 14H2 M22 14H19 M5 7L7 9 M19 7L17 9 M12 3V6 M7 14A5 5 0 0 1 17 14 M12 10V6 M9 8L12 5 15 8"
                          Stroke="#D8BA8A" StrokeThickness="1.5" />
                  </Canvas>
                </Viewbox>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="清晨" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="06:00" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
              </StackPanel>
            </Button>
            <Button x:Name="PresetDay" Grid.Column="1" Classes="preset" Margin="5,0" Tag="720"
                    Click="Preset_Click" Focusable="False" IsTabStop="False" AutomationProperties.Name="白天 12:00">
              <StackPanel Spacing="9">
                <Viewbox Width="22" Height="22" HorizontalAlignment="Left">
                  <Canvas Width="24" Height="24">
                    <Ellipse Width="9" Height="9" Canvas.Left="7.5" Canvas.Top="7.5"
                             Stroke="#E1C68A" StrokeThickness="1.5" />
                    <Path Data="M12 1V4 M12 20V23 M1 12H4 M20 12H23 M4.2 4.2L6.3 6.3 M17.7 17.7L19.8 19.8 M4.2 19.8L6.3 17.7 M17.7 6.3L19.8 4.2"
                          Stroke="#E1C68A" StrokeThickness="1.5" />
                  </Canvas>
                </Viewbox>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="白天" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="12:00" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
              </StackPanel>
            </Button>
            <Button x:Name="PresetDusk" Grid.Column="2" Classes="preset" Margin="5,0" Tag="1140"
                    Click="Preset_Click" Focusable="False" IsTabStop="False" AutomationProperties.Name="黄昏 19:00">
              <StackPanel Spacing="9">
                <Viewbox Width="22" Height="22" HorizontalAlignment="Left">
                  <Canvas Width="24" Height="24">
                    <Path Data="M3 18H21 M5 14H2 M22 14H19 M5 7L7 9 M19 7L17 9 M12 3V6 M7 14A5 5 0 0 1 17 14 M9 21H15"
                          Stroke="#D59E9D" StrokeThickness="1.5" />
                  </Canvas>
                </Viewbox>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="黄昏" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="19:00" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
              </StackPanel>
            </Button>
            <Button x:Name="PresetNight" Grid.Column="3" Classes="preset" Margin="5,0,0,0" Tag="1380"
                    Click="Preset_Click" Focusable="False" IsTabStop="False" AutomationProperties.Name="夜晚 23:00">
              <StackPanel Spacing="9">
                <Viewbox Width="22" Height="22" HorizontalAlignment="Left">
                  <Canvas Width="24" Height="24">
                    <Path Data="M20.9 13.2A9 9 0 0 1 10.8 3.1 9 9 0 1 0 20.9 13.2Z M18 2V6 M16 4H20"
                          Stroke="#B8A1E5" StrokeThickness="1.5" />
                  </Canvas>
                </Viewbox>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="夜晚" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="23:00" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>

        <Button Classes="restore" Click="Restore_Click" Focusable="False" IsTabStop="False"
                AutomationProperties.Name="恢复原样，跟随游戏环境">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Viewbox Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="M3 10A9 9 0 1 1 5 19 M3 4V10H9"
                      Stroke="#C4BDCE" StrokeThickness="1.6" />
              </Canvas>
            </Viewbox>
            <TextBlock Grid.Column="1" Text="恢复原样" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="跟随游戏环境" Classes="caption" FontSize="11" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Border x:Name="InlineMessage" IsVisible="False" Background="#251D1F"
                BorderBrush="#66434A" BorderThickness="1" CornerRadius="9" Padding="12,9">
          <TextBlock x:Name="InlineMessageText" FontSize="12" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border x:Name="UpdateOverlay" Grid.Row="1" IsVisible="False" Background="#E609090B"
            Padding="25,16" KeyboardNavigation.TabNavigation="Cycle">
      <Border Classes="card" Padding="22,18" MaxWidth="550" VerticalAlignment="Center">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="5">
              <TextBlock Text="软件更新" FontSize="19" FontWeight="SemiBold" />
              <TextBlock x:Name="UpdateVersionText" Classes="caption" />
            </StackPanel>
            <Button x:Name="HideUpdatesButton" Grid.Column="1" Classes="windowControl close" Click="HideUpdates_Click"
                    ToolTip.Tip="关闭更新面板" AutomationProperties.Name="关闭更新面板">
              <Path Data="M3 3L11 11 M11 3L3 11"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.2" Width="14" Height="14" />
            </Button>
          </Grid>
          <TextBlock Text="更新会在后台完成下载，准备好后点击重启即可安装。"
                     Classes="caption" TextWrapping="Wrap" />
          <StackPanel x:Name="UpdateSettingsFields" Spacing="9">
            <TextBlock Text="更新源" Classes="caption" IsVisible="False" />
            <TextBox x:Name="UpdateSourceText" FontSize="11" MinHeight="36" IsVisible="False"
                     Watermark="https://…/update.json" AutomationProperties.Name="更新清单链接" />
            <CheckBox x:Name="AutoCheckUpdates" Content="启动时自动检查，每 6 小时再检查一次" FontSize="12" MinHeight="27" IsVisible="False" />
            <CheckBox x:Name="AutoDownloadUpdates" Content="发现新版本后自动下载" FontSize="12" MinHeight="27" />
          </StackPanel>
          <Border Background="#1D1924" BorderBrush="#41334F" BorderThickness="1" CornerRadius="9" Padding="12,10">
            <StackPanel Spacing="8">
              <TextBlock x:Name="UpdateStatusText" Text="正在等待检查更新。" FontSize="12" TextWrapping="Wrap" />
              <ProgressBar x:Name="UpdateProgressBar" IsVisible="False" Height="4" Minimum="0" Maximum="100" />
              <TextBlock x:Name="UpdateNotesText" IsVisible="False" FontSize="11" Classes="caption"
                         TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button x:Name="CancelUpdateButton" Classes="updateAction" IsVisible="False" Click="CancelUpdate_Click" Content="取消" />
            <Button x:Name="CheckUpdatesButton" Grid.Column="1" Click="CheckUpdates_Click"
                    Content="检查更新" Classes="updateAction" Margin="0,0,10,0" />
            <Button x:Name="InstallUpdateButton" Grid.Column="2" Click="InstallUpdate_Click"
                    IsVisible="False" Content="下载更新" Classes="updateAction updatePrimary" />
          </Grid>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
  </Grid>
  </Border>
</Window>
