<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ETS2DayNightModern.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#9472D8" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Styles/TransportTheme.axaml" />
  </Application.Styles>
</Application>
